{
  "name": "smart-search-chips-tests",
  "private": true,
  "scripts": {
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-release.ps1 -Target all",
    "build:pro": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-release.ps1 -Target pro",
    "build:wporg": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-release.ps1 -Target wporg",
    "lint:php": "php scripts/lint-php.php .",
    "lint:wporg": "php scripts/validate-wporg-package.php",
    "release:wporg:check": "npm run build:wporg && npm run validate:wporg && npm run lint:wporg && npm run test:unit",
    "test:unit": "php tests/unit.php",
    "validate:wporg": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-wporg.ps1",
    "local:wp:start": "docker compose -f ./local-wp/compose.yml up -d db wordpress && docker compose -f ./local-wp/compose.yml run --rm wpcli sh /seed/seed.sh",
    "local:wp:seed": "docker compose -f ./local-wp/compose.yml run --rm wpcli sh /seed/seed.sh",
    "local:wp:stop": "docker compose -f ./local-wp/compose.yml down",
    "local:wp:reset": "docker compose -f ./local-wp/compose.yml down -v && docker compose -f ./local-wp/compose.yml up -d db wordpress && docker compose -f ./local-wp/compose.yml run --rm wpcli sh /seed/seed.sh",
    "local:wp:logs": "docker compose -f ./local-wp/compose.yml logs -f wordpress",
    "marketing:slides": "node ./marketing/screenshot-slides.mjs",
    "marketing:video": "node ./marketing/screenshot-slides.mjs && node ./marketing/record-showcase.mjs && ffmpeg -y -i ./marketing/video/smart-search-chips-showcase.webm -c:v libx264 -pix_fmt yuv420p -movflags +faststart -crf 20 ./marketing/video/smart-search-chips-showcase.mp4",
    "marketing:video:motion": "node ./marketing/record-motion-showcase.mjs",
    "test:browser": "playwright test",
    "test:browser:compat": "playwright test tests/browser/theme-compat-matrix.spec.js",
    "test:browser:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2"
  }
}
